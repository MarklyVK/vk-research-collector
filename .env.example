APP_ENV=development
LOG_LEVEL=INFO
TZ=UTC

# VK API
VK_API_VERSION=5.199
VK_TOKENS_FILE=/run/secrets/vk_tokens.txt
VK_REQUEST_TIMEOUT_SECONDS=30
VK_MAX_CONCURRENCY=3
VK_PER_TOKEN_RPS=2.5

# Ручная классификация
CLASSIFICATION_BATCH_SIZE=100
EXPORT_DIR=/app/exports/classification

# PostgreSQL
POSTGRES_DB=vk_research
POSTGRES_USER=vk_collector
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_BIND_ADDRESS=127.0.0.1

POSTGRES_READER_USER=vk_reader
POSTGRES_READER_PASSWORD=change_reader_password

DATABASE_URL=postgresql+asyncpg://vk_collector:change_me@postgres:5432/vk_research

# Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Контроль места на диске
DISK_WARNING_PERCENT=85
DISK_STOP_PERCENT=95
