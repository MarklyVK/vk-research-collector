APP_ENV=development
LOG_LEVEL=INFO
TZ=UTC

# VK API
VK_API_VERSION=5.199
VK_TOKENS_FILE=/run/secrets/vk_tokens.txt
VK_REQUEST_TIMEOUT_SECONDS=30
VK_MAX_CONCURRENCY=3
VK_PER_TOKEN_RPS=2.5
VK_METHOD_FLOOD_INITIAL_COOLDOWN_SECONDS=3600
VK_METHOD_QUOTA_INITIAL_COOLDOWN_SECONDS=3600
VK_METHOD_LIMIT_MAX_COOLDOWN_SECONDS=86400
VK_METHOD_LIMIT_PROBE_SECONDS=900
VK_GLOBAL_RPS_COOLDOWN_SECONDS=60
VK_LIMIT_ESCALATION_WINDOW_SECONDS=60
VK_LIMIT_ESCALATION_DISTINCT_METHODS=3

# Ручная классификация
CLASSIFICATION_BATCH_SIZE=100
EXPORT_DIR=/app/exports/classification

# PostgreSQL
POSTGRES_DB=vk_research
POSTGRES_USER=vk_collector
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_VOLUME_NAME=vk_research_postgres_data

POSTGRES_READER_USER=vk_reader
POSTGRES_READER_PASSWORD=change_reader_password

DATABASE_URL=postgresql+asyncpg://vk_collector:change_me@postgres:5432/vk_research

# Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKEN_FILE=/opt/vk-research-collector/secrets/telegram_bot_token.txt
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEZONE=Europe/Moscow
TELEGRAM_DAILY_TIME=09:00
TELEGRAM_HEALTH_INTERVAL_SECONDS=300
TELEGRAM_ALERT_REPEAT_SECONDS=10800
TELEGRAM_STALL_MINUTES=30
TELEGRAM_DISK_WARNING_PERCENT=85
TELEGRAM_DISK_CRITICAL_PERCENT=95
TELEGRAM_DISK_MIN_FREE_MB=1024
TELEGRAM_RAM_WARNING_AVAILABLE_MB=100
TELEGRAM_SWAP_WARNING_PERCENT=90
TELEGRAM_COLLECTION_RUN_ID=

# Контроль места на диске
DISK_WARNING_PERCENT=85
DISK_STOP_PERCENT=95

# Возобновляемый сбор approved-групп
COLLECTION_WORKER_ID=collector-1
COLLECTION_MAX_CONCURRENCY=3
COLLECTION_JOB_LEASE_SECONDS=300
COLLECTION_JOB_HEARTBEAT_SECONDS=60
COLLECTION_IDLE_SLEEP_SECONDS=5

COLLECTION_POSTS_ENABLED=true
COLLECTION_POSTS_MAX_PER_GROUP=100
COLLECTION_POSTS_PAGE_SIZE=100
COLLECTION_POSTS_INCLUDE_PINNED=true
COLLECTION_POSTS_STOP_AT_DATE=

COLLECTION_MEMBERS_ENABLED=true
COLLECTION_MEMBERS_MAX_PER_GROUP=200
COLLECTION_MEMBERS_PAGE_SIZE=1000

COLLECTION_USERS_ENABLED=true
COLLECTION_USER_PROFILE_TTL_DAYS=30
COLLECTION_USER_BATCH_SIZE=1000

COLLECTION_SUBSCRIPTIONS_ENABLED=false
COLLECTION_SUBSCRIPTIONS_MAX_PER_USER=50
COLLECTION_SUBSCRIPTIONS_PAGE_SIZE=50
COLLECTION_SUBSCRIPTIONS_USERS_PER_RUN=10000
COLLECTION_SUBSCRIPTIONS_TTL_DAYS=30

COLLECTION_SUBSCRIPTION_GROUP_POSTS_ENABLED=false
COLLECTION_SUBSCRIPTION_GROUP_POSTS_MAX=20
COLLECTION_SUBSCRIPTION_GROUP_POSTS_TTL_DAYS=30
COLLECTION_CAPACITY_REPORT_MAX_AGE_DAYS=30

COLLECTION_PILOT_SEED=20260728
COLLECTION_PILOT_GROUPS_PER_CATEGORY=10
COLLECTION_EXPORT_DIR=/app/exports/stage2-pilot
COLLECTION_RUN_ID=
